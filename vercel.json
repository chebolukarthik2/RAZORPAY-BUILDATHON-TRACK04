{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(html|js|css|json|png|jpg|svg|ico))", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/login.html" }
  ]
}
